{
  "id": "verification.profile.game.unity",
  "kind": "verification",
  "schema_version": 1,
  "capabilities": [
    "verification-checks",
    "project-readiness-policy"
  ],
  "payload": {
    "checks": [
      {
        "id": "test-1",
        "kind": "test",
        "command": [
          "Unity",
          "-runTests",
          "-batchmode",
          "-projectPath",
          ".",
          "-testPlatform",
          "EditMode",
          "-testResults",
          "Logs/editmode-results.xml"
        ],
        "required": true,
        "expected_evidence": {
          "requires_assertions": true
        },
        "execution_policy": {
          "mode": "exact-argv",
          "allowed_argv": [
            "Unity",
            "-runTests",
            "-batchmode",
            "-projectPath",
            ".",
            "-testPlatform",
            "EditMode",
            "-testResults",
            "Logs/editmode-results.xml"
          ],
          "cwd_scope": "project-root",
          "network_policy": "may-access-network",
          "write_effects": [
            "project-workspace"
          ],
          "timeout_seconds": 180,
          "output_limit": 800,
          "requires_confirmation": true
        }
      },
      {
        "id": "build-1",
        "kind": "build",
        "command": [
          "Unity",
          "-quit",
          "-batchmode",
          "-projectPath",
          ".",
          "-buildTarget",
          "StandaloneWindows64",
          "-buildWindows64Player",
          "Build/App.exe"
        ],
        "required": true,
        "expected_evidence": {},
        "execution_policy": {
          "mode": "exact-argv",
          "allowed_argv": [
            "Unity",
            "-quit",
            "-batchmode",
            "-projectPath",
            ".",
            "-buildTarget",
            "StandaloneWindows64",
            "-buildWindows64Player",
            "Build/App.exe"
          ],
          "cwd_scope": "project-root",
          "network_policy": "may-access-network",
          "write_effects": [
            "project-workspace"
          ],
          "timeout_seconds": 240,
          "output_limit": 800,
          "requires_confirmation": true
        }
      }
    ],
    "project_policy": {
      "config_manifests": [
        "ProjectSettings/ProjectVersion.txt"
      ],
      "module_boundary_patterns": [
        "**/*.asmdef"
      ],
      "mandatory_categories": [
        1,
        2,
        3,
        4,
        5,
        7,
        11,
        13,
        18,
        19
      ],
      "na_categories": []
    }
  }
}
