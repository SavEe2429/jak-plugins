{
  "id": "toolchain.rust-toolchain-file",
  "kind": "toolchain",
  "schema_version": 1,
  "capabilities": ["version-declaration", "runtime-probe"],
  "matches": [{ "path": "rust-toolchain.toml", "weight": 5 }],
  "payload": {
    "runtime": "rust",
    "version_file": "rust-toolchain.toml",
    "probe": ["rustc", "--version"],
    "version_pattern": "channel\\s*=\\s*\\\"(?P<version>[^\\\"]+)\\\"",
    "version_policy": "channel",
    "requirement_level": "required",
    "version_requirement_source": "project-declared",
    "environment_preparation": [
      "Install the Rust toolchain channel declared in rust-toolchain.toml, then re-run the policy audit."
    ],
    "generation": {
      "path": "rust-toolchain.toml",
      "content_template": "[toolchain]\\nchannel = \\\"{version}\\\"\\n",
      "validation_pattern": "(?:\\d+\\.\\d+\\.\\d+|stable|beta|nightly)"
    }
  }
}
